{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/server.ts",
    "src/cli/lineage.ts",
    "src/cli/lineage-channel.ts",
    "src/cli/lineage-dev.ts",
    "src/cli/lineage-preview.ts",
    "src/web/landing/main.tsx",
    "docs-site/astro.config.mjs",
    "docs-site/src/content.config.ts",
    "scripts/*.mjs",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "eslint.config.js",
    "tsconfig.build.json"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "docs-site/**/*.{js,mjs,ts}",
    "scripts/**/*.{js,mjs,ts}",
    "*.config.{js,mjs,ts}",
    "tsconfig.build.json"
  ],
  "ignore": [
    "dist/**",
    "coverage/**",
    ".lineage-scratch/**",
    "docs-site/.astro/**"
  ],
  "ignoreBinaries": ["gh", "ps"],
  "ignoreDependencies": ["@mean-weasel/lineage-node-editor-protocol"],
  "ignoreIssues": {
    "src/server/assetCore.ts": ["exports"],
    "src/server/assetLedgerApi.ts": ["exports", "types"],
    "src/server/assetReviews.ts": ["exports"],
    "src/shared/appConstants.ts": ["exports"]
  }
}
